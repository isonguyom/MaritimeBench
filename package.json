{
  "name": "maritimebench",
  "version": "1.0.0",
  "description": "A benchmark for evaluating AI models on operational voyage planning, maritime constraints, and ETA reasoning.",
  "private": true,
  "keywords": [
    "maritime",
    "benchmark",
    "ai-evaluation",
    "voyage-planning",
    "eta",
    "llm-evaluation",
    "maritime-engineering"
  ],
  "type": "commonjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "eval": "tsx src/eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "quality": "npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0",
    "dotenv": "^18.0.9",
    "openai": "^7.47.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
